# Copie a .env y ajuste las variables antes de instalar.
# El puerto se publica exclusivamente en 127.0.0.1.
PORT=8765
# Netdata debe ser accesible desde el contenedor; localhost sería el propio contenedor.
NETDATA_URL=http://host.docker.internal:19999
NETDATA_CHARTS=
POLL_INTERVAL_SECONDS=30
HISTORY_RETENTION_DAYS=30
TZ=Europe/Madrid
# NETDATA_TOKEN= (opcional; mantener privado)
