{
    auto_https off
    admin off
}

http://{$AUTH_HOST}:8080 {
    reverse_proxy authelia:9091 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {$AUTH_HOST}
    }
}

http://{$STATUS_HOST}:8080 {
    route {
        forward_auth authelia:9091 {
            uri /api/authz/forward-auth
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {$STATUS_HOST}
        }
        reverse_proxy app:8765 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {$STATUS_HOST}
            header_up -Remote-User
            header_up -Remote-Groups
            header_up -Remote-Email
            header_up -Remote-Name
        }
    }
}
